---
const cards = await Astro.glob("../content/*.md");
---

{
  cards.map((card) => (
    <section>
      <h2>{card.frontmatter.title}</h2>
      <ul>
        {card.frontmatter.links.map((link) => (
          <li>
            <a
              href={link.href}
              data-app-url={link.appUrl}
              class={link.appUrl ? "has-app-url" : ""}
            >
              <img class="svg-icon" src={link.src} alt={link.alt} />
              {link.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))
}

<style>
  section {
    background: var(--card-background-color);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid var(--card-border-color);
    border-radius: var(--border-radius);
    width: 170px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 35px;
    height: fit-content;
    box-shadow:
      0 8px 32px 0 rgba(0, 0, 0, 0.2),
      0 2px 8px 0 rgba(0, 0, 0, 0.1);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    animation: fadeIn 0.6s ease-out forwards;
    opacity: 0;
    position: relative;
    z-index: 1;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  section:nth-child(1) { animation-delay: 0.1s; }
  section:nth-child(2) { animation-delay: 0.2s; }
  section:nth-child(3) { animation-delay: 0.3s; }
  section:nth-child(4) { animation-delay: 0.4s; }

  section:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow:
      0 12px 48px 0 rgba(0, 0, 0, 0.3),
      0 4px 16px 0 var(--hover-glow);
    border-color: var(--accent-color);
  }

  h2 {
    font-weight: 700;
    font-size: 24px;
    letter-spacing: 0.5px;
    background: linear-gradient(135deg, var(--text-color) 0%, var(--accent-color) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: -10px;
  }

  ul {
    list-style-type: none;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  ul li {
    font-size: 18px;
  }

  ul li a {
    color: var(--text-color);
    text-decoration: none;
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    gap: 12px;
    padding: 8px 10px;
    border-radius: 10px;
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  ul li a::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 100%;
    background: var(--hover-glow);
    transition: width 0.3s ease;
    z-index: -1;
  }

  ul li a:hover::before {
    width: 100%;
  }

  ul li a:hover {
    transform: translateX(5px);
    background: var(--hover-glow);
  }

  ul li a:visited {
    color: var(--text-color);
  }

  ul li a img {
    max-width: 24px;
    max-height: 24px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  ul li a:hover img {
    transform: scale(1.15) rotate(5deg);
    filter: drop-shadow(0 0 8px var(--accent-color));
  }

  .svg-icon {
    filter: brightness(0) invert(1);
  }

  @media (prefers-color-scheme: dark) {
    .svg-icon {
      filter: brightness(0) invert(1);
    }
  }

  @media (prefers-color-scheme: light) {
    .svg-icon {
      filter: brightness(0) invert(1);
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const linksWithApps = document.querySelectorAll("a.has-app-url");

    linksWithApps.forEach((link) => {
      link.addEventListener("click", (e) => {
        const appUrl = link.getAttribute("data-app-url");
        const fallbackUrl = link.getAttribute("href");

        if (appUrl) {
          e.preventDefault();

          // Try to open the app
          const startTime = Date.now();
          window.location.href = appUrl;

          // Set a timer to fallback to website if app doesn't open
          setTimeout(() => {
            // If we're still on the page after 1.5 seconds, the app likely didn't open
            const timeElapsed = Date.now() - startTime;
            if (timeElapsed >= 1400) {
              window.location.href = fallbackUrl;
            }
          }, 1500);

          // Also check if window loses focus (app opened)
          const onBlur = () => {
            // App likely opened, clear the fallback
            window.removeEventListener("blur", onBlur);
          };
          window.addEventListener("blur", onBlur);
        }
      });
    });
  });
</script>
