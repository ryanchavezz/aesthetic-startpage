---
const cards = await Astro.glob("../content/*.md");
---

{
  cards.map((card) => (
    <section>
      <h2>{card.frontmatter.title}</h2>
      <ul>
        {card.frontmatter.links.map((link) => (
          <li>
            <a
              href={link.href}
              data-app-url={link.appUrl}
              class={link.appUrl ? "has-app-url" : ""}
            >
              <img class="svg-icon" src={link.src} alt={link.alt} />
              {link.title}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))
}

<style>
  section {
    background: var(--card-background);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid var(--card-border);
    border-radius: 18px;
    box-shadow:
      0 2px 8px var(--shadow),
      0 1px 2px rgba(0, 0, 0, 0.02),
      inset 0 1px 0 rgba(255, 255, 255, 0.5);
    width: 170px;
    padding: var(--size-5);
    display: flex;
    flex-direction: column;
    gap: var(--size-5);
    height: fit-content;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  section:hover {
    box-shadow:
      0 8px 24px var(--shadow-hover),
      0 4px 8px rgba(0, 0, 0, 0.04),
      inset 0 1px 0 rgba(255, 255, 255, 0.5);
    transform: translateY(-4px) scale(1.01);
    border-color: var(--card-border);
  }

  h2 {
    font-family: var(--header-font-family);
    font-weight: 600;
    font-size: var(--font-size-3);
    letter-spacing: -0.3px;
    color: var(--text-primary);
  }

  ul {
    list-style-type: none;
    display: flex;
    flex-direction: column;
    gap: var(--size-3);
  }

  ul li {
    font-size: var(--font-size-2);
  }

  ul li a {
    color: var(--text-secondary);
    text-decoration: none;
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    gap: var(--size-2);
    padding: var(--size-2);
    border-radius: 10px;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  ul li a:hover {
    background-color: rgba(0, 122, 255, 0.08);
    color: var(--accent);
    transform: translateX(2px);
  }

  ul li a:visited {
    color: var(--text-secondary);
  }

  ul li a img {
    max-width: 24px;
    max-height: 24px;
    transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0.85;
  }

  ul li a:hover img {
    transform: scale(1.05);
    opacity: 1;
  }

  .svg-icon {
    filter: invert(0%);
  }

  @media (prefers-color-scheme: dark) {
    .svg-icon {
      filter: invert(100%);
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const linksWithApps = document.querySelectorAll("a.has-app-url");

    linksWithApps.forEach((link) => {
      link.addEventListener("click", (e) => {
        const appUrl = link.getAttribute("data-app-url");
        const fallbackUrl = link.getAttribute("href");

        if (appUrl) {
          e.preventDefault();

          // Try to open the app
          const startTime = Date.now();
          window.location.href = appUrl;

          // Set a timer to fallback to website if app doesn't open
          setTimeout(() => {
            // If we're still on the page after 1.5 seconds, the app likely didn't open
            const timeElapsed = Date.now() - startTime;
            if (timeElapsed >= 1400) {
              window.location.href = fallbackUrl;
            }
          }, 1500);

          // Also check if window loses focus (app opened)
          const onBlur = () => {
            // App likely opened, clear the fallback
            window.removeEventListener("blur", onBlur);
          };
          window.addEventListener("blur", onBlur);
        }
      });
    });
  });
</script>
